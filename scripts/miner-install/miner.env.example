# Operator values for the SN24 miner units installed by
# scripts/miner-install/install.sh. Copy to /etc/mscomputer-miner/miner.env
# (root:mc-miner, mode 0640) and replace every <placeholder>. This file holds
# no secret. There are no artifact-store credentials: the agent reads
# artifacts through the operator's signed pull gateway with its service key.
MC_NETWORK=finney
MC_NETUID=24
MC_WALLET=<wallet-name>
MC_HOTKEY=<hotkey-name>
MC_HOTKEY_SS58=<hotkey-ss58-address>
MC_UID=<your-uid>
MC_AXON_PORT=8091
# Leaf fingerprint printed by: scripts/manage-miner-tls.sh issue /etc/mscomputer-miner/tls <public-ip> 90
MC_TLS_SHA256=<64-hex-leaf-sha256>
# The SN24 operator (validator) hotkey.
MC_OPERATOR_HOTKEY_SS58=5ELAvsvXL9kU9CMzkFcRiqFjw3QGVgA7MrvEfcHsicv5WvWX
# The axon (8091) and direct-files (8094) listeners are publicly reachable.
# No tunnel is required. The miner never publishes an axon on chain; it
# self-enrolls its public IP and axon port with validators through the
# hotkey-signed endpoint enrollment (docs/miner-endpoint-enrollment.md).
# Optional extra flags, split on whitespace (for example
# MC_AGENT_EXTRA_ARGS=--static-sites off).
MC_AGENT_EXTRA_ARGS=
MC_NEURON_EXTRA_ARGS=
# Private endpoint enrollment (default on): the miner signs its direct address
# for the operator every 6 h. MC_PUBLIC_IP=auto uses the address the request
# comes from; set it if validators must dial a different public IP.
#MC_PUBLIC_IP=auto
#MC_ENDPOINT_ENROLL=off
